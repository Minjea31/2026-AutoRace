Panels:
- Class: rviz_common/Displays
  Help Height: 70
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Axes1
    Splitter Ratio: 0.5
  Tree Height: 320
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 0.20000000298023224
    Class: rviz_default_plugins/Grid
    Color: 100; 100; 100
    Enabled: true
    Line Style:
      Line Width: 0.009999999776482582
      Value: Lines
    Name: Grid (20 cm)
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 30
    Reference Frame: base_link
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/LaserScan
    Color: 255; 60; 60
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 4096
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: LiDAR /scan (red)
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 4
    Size (m): 0.009999999776482582
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /scan
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Obstacle boxes (blue observed, orange remembered)
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /parking/obstacles
    Value: true
  - Class: rviz_default_plugins/RobotModel
    Enabled: true
    Name: LIMO (sensor robot description)
    Alpha: 1
    Visual Enabled: true
    Collision Enabled: false
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
    TF Prefix: ''
    Update Interval: 0
    Links:
      All Links Enabled: true
      Expand Joint Details: false
      Expand Link Details: false
      Expand Tree: false
      Link Tree Style: Links in Alphabetic Order
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Parking target
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /parking/target
    Value: true
  - Alpha: 1
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 40; 255; 80
    Enabled: true
    Head Diameter: 0.02500000037252903
    Head Length: 0.029999999329447746
    Length: 0.30000001192092896
    Line Style: Billboards
    Line Width: 0.02
    Name: Parking and reverse path (green)
    Offset:
      X: 0
      Y: 0
      Z: 0
    Pose Color: 40; 200; 255
    Pose Style: Arrows
    Radius: 0.029999999329447746
    Shaft Diameter: 0.009999999776482582
    Shaft Length: 0.07000000029802322
    Topic:
      Depth: 1
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /parking/path
    Value: true
  - Class: rviz_default_plugins/Axes
    Enabled: true
    Length: 0.10000000149011612
    Name: Axes
    Radius: 0.009999999776482582
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/TF
    Name: Sensor TF (optional)
    Enabled: false
    Value: false
    Frame Timeout: 15
    Frames:
      All Enabled: true
    Marker Scale: 0.15
    Show Arrows: true
    Show Axes: true
    Show Names: true
    Update Interval: 0
  - Class: rviz_default_plugins/Odometry
    Name: Fused localization (optional)
    Enabled: false
    Value: false
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /parking/localization/odometry
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 40; 230; 230
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 4096
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: Remembered obstacles (cyan)
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.009999999776482582
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /parking/obstacle_memory
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/Measure
    Line color: 255; 255; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: 1.57079632679
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Scale: 180
      Target Frame: base_link
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0.6
      Y: -0.5
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 850
  Hide Left Dock: false
  Hide Right Dock: false
  Views:
    collapsed: false
  Width: 1280
  X: 40
  Y: 40
