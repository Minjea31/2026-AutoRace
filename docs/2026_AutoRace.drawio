Y=1;exitPerimeter=0;entryX=0.35;entryY=1;entryPerimeter=0;fontStyle=1;" target="mux_ws" value="&lt;div style=&quot;font-weight:700;line-height:1.15&quot;&gt;&lt;span style=&quot;font-size:20px;font-weight:700&quot;&gt;/mission/lane&lt;/span&gt;&lt;span style=&quot;font-size:16px;font-weight:700&quot;&gt; · ackermann_msgs/msg/AckermannDriveStamped&lt;/span&gt;&lt;/div&gt;"><mxGeometry relative="1" as="geometry"><mxPoint x="311.75" y="-22" as="offset"/><Array as="points"><mxPoint x="1170" y="2750"/><mxPoint x="3926.5" y="2750"/></Array></mxGeometry></mxCell><mxCell id="전체-edge-28" edge="1" parent="1" source="mux_ws" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#00695C;strokeWidth=2.3;fontColor=#00695C;fontFamily=Noto Sans CJK KR;fontSize=16;align=center;verticalAlign=middle;whiteSpace=wrap;labelWidth=600;labelBackgroundColor=#FFFFFF;spacing=3;exitX=1;exitY=0.46169354838709675;exitPerimeter=0;fontStyle=1;" value="&lt;div style=&quot;font-weight:700;line-height:1.15&quot;&gt;&lt;span style=&quot;font-size:20px;font-weight:700&quot;&gt;/cmd_vel&lt;/span&gt;&lt;span style=&quot;font-size:16px;font-weight:700&quot;&gt; · geometry_msgs/msg/Twist&lt;/span&gt;&lt;/div&gt;"><mxGeometry relative="1" as="geometry"><mxPoint y="-27" as="offset"/><mxPoint x="5060" y="1355" as="targetPoint"/></mxGeometry></mxCell><mxCell id="bool-contract" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK KR;fontSize=18;fontColor=#556477;fontStyle=1;spacing=0;" value="&lt;div style=&quot;font-weight:700;line-height:1.15&quot;&gt;&lt;span style=&quot;font-size:24px;font-weight:700&quot;&gt;YOLO Bool 계약&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;font-weight:700&quot;&gt;/yolo/bump_sign : true = 방지턱 표지판 감지&lt;br&gt;/yolo/slow_sign : true = 지그재그 서행 표지판 감지&lt;br&gt;/yolo/crosswalk_sign : true = 보행자 표지판 감지&lt;br&gt;/yolo/parking_sign : true = 주차 표지판 감지&lt;br&gt;/yolo/LR_sign : false = LEFT / true = RIGHT&lt;br&gt;/yolo/signal : false = RED / true = GREEN&lt;br&gt;&lt;br&gt;bump / slow는 둘 다 기존 slow_ws가 수신&lt;br&gt;검출된 새 영상에서만 최대 10 Hz 발행&lt;br&gt;&lt;br&gt;모든 미검출은 false로 보내지 않고 발행 생략.&lt;br&gt;미션은 수신 유효 시간과 자기 실행 상태로 처리.&lt;/span&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="470" width="650" x="930" y="600" as="geometry"/></mxCell><mxCell id="track-order" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK KR;fontSize=18;fontColor=#556477;fontStyle=1;spacing=0;" value="&lt;div style=&quot;font-weight:700;line-height:1.15&quot;&gt;실제 트랙 주행 순서: 방지턱(slow) → 지그재그(slow) → crosswalk → objavoid → 갈림길(lane) → cone → signal → parking&lt;br&gt;미션은 /mission/{이름}/command_XX · 유효한 미션 command가 없으면 /mission/lane을 기본값으로 선택&lt;/div&gt;" vertex="1"><mxGeometry height="105" width="5090" x="70" y="2820" as="geometry"/></mxCell><mxCell id="전체-edge-10-lidar" edge="1" parent="1" source="sensor_lidar" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#E65100;strokeWidth=1.9;fontColor=#E65100;fontFamily=Noto Sans CJK KR;fontSize=16;align=center;verticalAlign=middle;whiteSpace=wrap;labelWidth=610;labelBackgroundColor=#FFFFFF;spacing=3;exitX=1;exitY=0.2;exitPerimeter=0;entryX=0;entryY=0.31;entryPerimeter=0;fontStyle=1;" target="parking_ws" value="&lt;div style=&quot;font-weight:700;line-height:1.15&quot;&gt;&lt;span style=&quot;font-size:20px;font-weight:700&quot;&gt;/scan&lt;/span&gt;&lt;span style=&quot;font-size:16px;font-weight:700&quot;&gt; · sensor_msgs/msg/LaserScan&lt;/span&gt;&lt;/div&gt;"><mxGeometry relative="1" as="geometry"><mxPoint x="376.9749999999999" y="-524.05" as="offset"/><Array as="points"><mxPoint x="1980" y="1432"/><mxPoint x="1980" y="925.95"/></Array></mxGeometry></mxCell><mxCell id="전체-edge-15-lidar" edge="1" parent="1" source="sensor_lidar" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;endArrow=