<?xml version="1.0"?>
<package format="3">
  <name>yolo_detect</name>
  <version>0.1.0</version>
  <description>YOLO sign detection for AutoRace using compressed camera images.</description>
  <maintainer email="wego@example.com">wego</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-torch</exec_depend>
  <!-- Install the bundled Ultralytics source with pip; see ../README.md. -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
