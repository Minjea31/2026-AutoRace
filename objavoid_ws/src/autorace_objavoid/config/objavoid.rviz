Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/MarkerArray
      Name: Lane reference and estimated road limits
      Enabled: true
      Value: true
      Namespaces:
        lane_center: true
        road_limits: true
        lane_id: true
        command_path: false
      Topic:
        Value: /objavoid/markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Queue Size: 10
    - Class: rviz_default_plugins/Image
      Name: Lane detections
      Enabled: true
      Value: true
      Topic:
        Value: /lane_lite/debug
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Normalize Range: true
      Min Value: 0
      Max Value: 1
      Median window: 5
    - Class: rviz_default_plugins/MarkerArray
      Name: Command path
      Enabled: true
      Value: true
      Namespaces:
        command_path: true
        lane_center: false
        road_limits: false
        lane_id: false
      Topic:
        Value: /objavoid/markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Queue Size: 10
    - Class: rviz_default_plugins/MarkerArray
      Name: Detected obstacles
      Enabled: true
      Value: true
      Namespaces:
        cluster_boxes: true
      Topic:
        Value: /objavoid/clusters
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Queue Size: 10
  Enabled: true
  Global Options:
    Background Color: 22; 26; 32
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: base_link
      Near Clip Distance: 0.01
      Scale: 200
      Angle: -1.5707963267948966
      X: 0.45
      Y: 0
    Saved: ~
Window Geometry:
  Width: 1100
  Height: 800
  Hide Left Dock: false
  Hide Right Dock: true
